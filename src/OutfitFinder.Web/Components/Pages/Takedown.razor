@inject OutfitApiClient Api

<h1 class="h1s">Report content</h1>
<p class="m" style="margin: 0">Ask us to remove a photo or result: for example a photo of you uploaded without permission, a copyright claim, or anything unsafe.</p>
@if (_sent)
{
    <div class="note mint" role="status">Thanks. We've received your report and will reply within 5 working days if you left an email.</div>
}
else
{
    <EditForm Model="_form" OnValidSubmit="Send" class="card pop stack" FormName="takedown">
        <DataAnnotationsValidator />
        <div class="f">
            <label class="lab" for="td-reason">Reason</label>
            <InputSelect id="td-reason" class="in" @bind-Value="_form.Reason">
                @* Short labels: a phone's select box shows about 25 characters. *@
                <option value="takedown">A photo of me</option>
                <option value="copyright">Copyright</option>
                <option value="unsafe">Unsafe or illegal</option>
                <option value="other">Something else</option>
            </InputSelect>
        </div>
        <div class="f">
            <label class="lab" for="td-url">Link to the look or content</label>
            <InputText id="td-url" class="in" @bind-Value="_form.Url" placeholder="https://" />
            <ValidationMessage For="() => _form.Url" />
        </div>
        <div class="f">
            <label class="lab" for="td-details">What should we know?</label>
            <InputTextArea id="td-details" class="in" @bind-Value="_form.Details" />
            <ValidationMessage For="() => _form.Details" />
        </div>
        <div class="f">
            <label class="lab" for="td-email">Your email (so we can reply)</label>
            <InputText id="td-email" class="in" type="email" @bind-Value="_form.Email" autocomplete="email" />
            <ValidationMessage For="() => _form.Email" />
        </div>
        @if (_error is not null) { <div class="err" role="alert">@_error</div> }
        <button type="submit" class="b" disabled="@_busy">Send report</button>
    </EditForm>
}

@code {
    private readonly TakedownForm _form = new();
    private bool _sent, _busy;
    private string? _error;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    /// <summary>Opened from a look, the link arrives as ?link=…; only links to this site are accepted.</summary>
    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("link", out var link) && Uri.TryCreate(link.ToString(), UriKind.Absolute, out var u)
            && u.ToString().StartsWith(Nav.BaseUri, StringComparison.OrdinalIgnoreCase))
            _form.Url = u.ToString();
    }

    private sealed class TakedownForm
    {
        public string Reason { get; set; } = "takedown";
        [System.ComponentModel.DataAnnotations.Url(ErrorMessage = "Enter a full link starting with https://")] public string? Url { get; set; }
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Tell us what to remove and why."), System.ComponentModel.DataAnnotations.StringLength(4000)] public string Details { get; set; } = "";
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "That doesn't look like an email address.")] public string? Email { get; set; }
    }

    private async Task Send()
    {
        _busy = true; _error = null;
        try
        {
            await Api.ReportAsync(new ReportRequest(null, _form.Reason, _form.Details, _form.Email, _form.Url));
            _sent = true;
        }
        catch (ApiException e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
