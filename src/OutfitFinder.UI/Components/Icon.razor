@* Inline SVG icons. Stroke uses currentColor so icons follow the text color in both themes. *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round"
     class="@Class" aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label">
    @switch (Name)
    {
        case "hanger": <path d="M12 8a2 2 0 1 0-2-2" /><path d="M12 8v2l8.5 6.2a1 1 0 0 1-.6 1.8H4.1a1 1 0 0 1-.6-1.8L12 10" /> break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h16" /> break;
        case "close": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "moon": <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /> break;
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" /> break;
        case "photo": <rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="9" cy="10" r="1.6" /><path d="M21 16l-5-5-8 8" /> break;
        case "camera": <path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /> break;
        case "check": <path d="M5 12.5l4.5 4.5L19 7.5" /> break;
        case "spinner": <path d="M12 3a9 9 0 1 0 9 9" /> break;
        case "circle": <circle cx="12" cy="12" r="8" /> break;
        case "alert": <path d="M12 3l10 18H2z" /><path d="M12 10v4M12 17.5v.5" /> break;
        case "thumb-up": <path d="M7 11v9H4v-9zM7 11l4-8c1.5 0 2.5 1 2.5 2.5V9H19a2 2 0 0 1 2 2.3l-1.2 6.5A2 2 0 0 1 17.8 20H7" /> break;
        case "thumb-down": <path d="M17 13V4h3v9zM17 13l-4 8c-1.5 0-2.5-1-2.5-2.5V15H5a2 2 0 0 1-2-2.3l1.2-6.5A2 2 0 0 1 6.2 4H17" /> break;
        case "external": <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /> break;
        case "trash": <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /> break;
        case "refresh": <path d="M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6" /> break;
        case "edit": <path d="M4 20h4L19 9l-4-4L4 16z" /> break;
        case "flag": <path d="M5 21V4M5 4h11l-2 4 2 4H5" /> break;
        case "download": <path d="M12 4v11M7 10l5 5 5-5M5 20h14" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "scissors": <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M8.1 8.1L20 20M8.1 15.9L20 4" /> break;
        default: <circle cx="12" cy="12" r="2" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public double Stroke { get; set; } = 2.2;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
}
