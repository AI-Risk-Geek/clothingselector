@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<main class="wrap w-sm" id="main">
    <h1 class="h1s">Forgot your password?</h1>
    @if (Model.Sent)
    {
        <div class="note mint" role="status">If that account has an email address, we've sent a reset link to it. Check your inbox.</div>
        <a class="b w" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
    }
    else
    {
        <p class="m" style="margin: 0">Enter your username. If you added an email when you signed up, we'll send a reset link. Accounts without an email can't be recovered.</p>
        <form method="post" class="card pop stack" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="f">
                <label class="lab" asp-for="UserName">Username</label>
                <input class="in" asp-for="UserName" autocomplete="username" autofocus />
                <span class="field-validation-error" asp-validation-for="UserName"></span>
            </div>
            <button type="submit" class="b">Send reset link</button>
            <a class="lk" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
        </form>
    }
</main>
