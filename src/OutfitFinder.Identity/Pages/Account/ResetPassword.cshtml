@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Model.LinkInvalid ? "Reset link doesn't work" : "Choose a new password";
}
<main class="wrap w-sm" id="main">
    @if (Model.LinkInvalid)
    {
        <h1 class="h1s">This link doesn't work</h1>
        <div class="card pop stack">
            <p style="margin: 0">Password reset links work once and expire after a day. This one is missing, expired or already used.</p>
            <a class="b" asp-page="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Send me a new link</a>
            <a class="lk" style="align-self: center" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
        </div>
    }
    else
    {
        <h1 class="h1s">Choose a new password</h1>
        <form method="post" class="card pop stack" novalidate>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <div class="f">
                <label class="lab" asp-for="Password">New password</label>
                <input class="in" asp-for="Password" autocomplete="new-password" autofocus />
                <span class="m tiny">At least 10 characters.</span>
                <span class="field-validation-error" asp-validation-for="Password"></span>
            </div>
            <div class="f">
                <label class="lab" asp-for="ConfirmPassword">Confirm new password</label>
                <input class="in" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span class="field-validation-error" asp-validation-for="ConfirmPassword"></span>
            </div>
            <button type="submit" class="b">Save new password</button>
        </form>
    }
</main>
