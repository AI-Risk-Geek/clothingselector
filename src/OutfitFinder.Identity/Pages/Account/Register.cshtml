@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
    var web = (Configuration["Clients:Web:Url"] ?? "").TrimEnd('/');
}
<main class="wrap w-sm" id="main">
    <h1 class="h1s" style="text-align: center">Save your looks</h1>
    <partial name="_AuthTabs" model='("up", Model.ReturnUrl)' />
    <form method="post" class="card pop stack" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="f">
            <label class="lab" asp-for="Input.UserName">Username</label>
            <input class="in" asp-for="Input.UserName" autocomplete="username" autofocus aria-describedby="un-help" />
            <span class="m tiny" id="un-help">Letters, numbers, dots, dashes and underscores.</span>
            <span class="field-validation-error" asp-validation-for="Input.UserName"></span>
        </div>
        <div class="f">
            <label class="lab" asp-for="Input.Email">Email <span class="m">(optional)</span></label>
            <input class="in" asp-for="Input.Email" autocomplete="email" aria-describedby="em-help" />
            <span class="m tiny" id="em-help">Only used to reset your password. Without it, a forgotten password can't be recovered.</span>
            <span class="field-validation-error" asp-validation-for="Input.Email"></span>
        </div>
        <div class="f">
            <label class="lab" asp-for="Input.Password">Password</label>
            <input class="in" asp-for="Input.Password" autocomplete="new-password" aria-describedby="pw-help" />
            <span class="m tiny" id="pw-help">At least 10 characters.</span>
            <span class="field-validation-error" asp-validation-for="Input.Password"></span>
        </div>
        <div class="f">
            <label class="lab" asp-for="Input.ConfirmPassword">Confirm password</label>
            <input class="in" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span class="field-validation-error" asp-validation-for="Input.ConfirmPassword"></span>
        </div>
        <label class="check">
            <input type="checkbox" asp-for="Input.Agree" />
            <span>I am 16 or older and agree to the <a href="@web/legal/terms" target="_blank">Terms</a> and <a href="@web/legal/privacy" target="_blank">Privacy Policy</a>.</span>
        </label>
        <span class="field-validation-error" asp-validation-for="Input.Agree"></span>
        @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
        {
            <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-theme="auto"></div>
        }
        <button type="submit" class="b">Create account</button>
    </form>
    <p class="m small" style="margin: 0; text-align: center">Looks you found on this device move into your account when you sign in.</p>
</main>
@section Scripts {
    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
