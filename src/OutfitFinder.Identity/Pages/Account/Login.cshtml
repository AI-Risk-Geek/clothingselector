@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<main class="wrap w-sm" id="main">
    <h1 class="h1s" style="text-align: center">Welcome back</h1>
    <partial name="_AuthTabs" model='("in", Model.ReturnUrl)' />
    <form method="post" class="card pop stack" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        @if (Model.Error is not null)
        {
            <div class="note danger" role="alert">@Model.Error</div>
        }
        @if (Model.Info is not null)
        {
            <div class="note mint" role="status">@Model.Info</div>
        }
        <div class="f">
            <label class="lab" asp-for="Input.UserName">Username</label>
            <input class="in" asp-for="Input.UserName" autocomplete="username" autofocus />
            <span class="field-validation-error" asp-validation-for="Input.UserName"></span>
        </div>
        <div class="f">
            <label class="lab" asp-for="Input.Password">Password</label>
            <input class="in" asp-for="Input.Password" autocomplete="current-password" />
            <span class="field-validation-error" asp-validation-for="Input.Password"></span>
        </div>
        <label class="check"><input type="checkbox" asp-for="Input.Remember" /> <span>Keep me signed in on this device</span></label>
        <button type="submit" class="b">Sign in</button>
        <div class="cluster" style="justify-content: center; gap: 0 18px">
            <a class="lk" asp-page="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Forgot password?</a>
        </div>
    </form>
    <p class="m small" style="margin: 0; text-align: center">Looks you found on this device move into your account when you sign in.</p>
</main>
