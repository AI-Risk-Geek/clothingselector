{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "MySql", "MigrateOnStartup": false },
  "ConnectionStrings": { "OutfitDb": "" },
  "Identity": { "Authority": "" },
  "Api": { "PublicBaseUrl": "", "UrlSigningKey": "" },
  "Storage": { "Provider": "Azure", "BlobConnection": "", "Container": "outfits" },
  "AI": { "Provider": "", "Model": "", "Deployment": "", "Endpoint": "", "ApiKey": "", "WebSearchEnabled": true, "TimeoutSeconds": 120 },
  "Safety": { "Mode": "AzureContentSafety", "ContentSafetyEndpoint": "", "ContentSafetyKey": "", "RejectSeverity": 2, "SafeBrowsingApiKey": "" },
  "Turnstile": { "SiteKey": "", "SecretKey": "" },
  "Limits": {
    "SearchesPerVisitorPerDay": 5,
    "SearchesPerUserPerDay": 25,
    "SearchesPerIpPerDay": 60,
    "DailyBudgetUsd": 25,
    "ModerationRejectionsBeforeBlock": 3,
    "RequireCaptchaForAnonymousUpload": true,
    "IpHashSalt": ""
  },
  "Retention": { "Days": 90 },
  "Worker": { "Enabled": true, "PollMilliseconds": 1500, "StuckAfterSeconds": 300, "Parallel": 2 },
  "Extension": { "Id": "" },
  "Cors": { "Origins": [] }
}
